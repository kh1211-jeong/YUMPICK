# 이 값들을 채워서 .env.local 로 복사하세요. 실제 값은 절대 커밋하지 마세요.

# 네이버 지도 Web Dynamic Map - console.ncloud.com 에서 발급
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Supabase 프로젝트 설정 > API 에서 확인 (anon/public key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 측정 ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# 네이버 검색(지역) API - developers.naver.com 에서 애플리케이션 등록 후 발급 (서버 전용)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Gemini API 키 - aistudio.google.com 에서 발급 (서버 전용)
GEMINI_API_KEY=
