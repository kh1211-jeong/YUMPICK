# 이 값들을 채워서 .env.local 로 복사하세요. 실제 값은 절대 커밋하지 마세요.

# 카카오맵 JavaScript 키 - developers.kakao.com 앱 설정 > 앱 키 (브라우저 노출 OK)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Supabase 프로젝트 설정 > API 에서 확인 (anon/public key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Analytics 4 측정 ID (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# 카카오 로컬 API용 REST API 키 - developers.kakao.com 앱 설정 > 앱 키 (서버 전용, 카카오맵 서비스 활성화 필요)
KAKAO_REST_API_KEY=

# Gemini API 키 - aistudio.google.com 에서 발급 (서버 전용)
GEMINI_API_KEY=
